# 프론트엔드 환경변수 템플릿
# 이 파일을 .env.local 로 복사해서 값을 채운다 (.env.local 은 커밋되지 않는다)
#
#   cp .env.example .env.local
#
# ⚠️ 중요: Next.js 에서 NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 박힌다.
#    즉 사용자가 개발자도구로 전부 볼 수 있다.
#    비밀값(JWT 서명키, DB 비밀번호, OpenAI 키 등)은 절대 이 파일에 넣지 않는다.
#    그것들은 백엔드의 .env 에만 존재해야 한다.

# 백엔드 API 주소.
#   - 비워두면: MSW 목(mock)으로 동작한다. 백엔드 없이 화면만 볼 때 쓴다.
#     목 로그인 계정 = demo@goodquestion.dev / demo1234!
#   - 로컬 백엔드: http://localhost:8081
#     (8080 은 다른 프로젝트가 쓰고 있어 백엔드를 8081 로 띄운다)
#   - 배포 백엔드: https://potentialgoodquestionbackend-production.up.railway.app
#
# 백엔드 CORS 가 http://localhost:3000 만 허용하므로 프론트는 3000 포트로 띄운다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
